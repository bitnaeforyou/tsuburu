<?xml version="1.0" encoding="utf-8"?>
<!-- The server this app talks to is inside this app, on the loopback
     address. Android forbids plain HTTP by default, which is right for
     anything that leaves the phone and wrong for something that never does,
     so the exception is for the loopback address and nothing else. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
