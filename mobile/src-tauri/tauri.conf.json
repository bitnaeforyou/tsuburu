{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tsuburu",
  "version": "0.3.9",
  "identifier": "la.tsuburu.tsuburu",
  "build": {
    "frontendDist": "../placeholder",
    "devUrl": "http://127.0.0.1:8420"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
