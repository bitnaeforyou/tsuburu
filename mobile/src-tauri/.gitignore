# Cargo
/target/

# Written by `tauri ios init` / `tauri android init` from project.yml and the
# config. Regenerate them rather than committing them: they hold absolute
# paths from whichever machine ran the command.
/gen/schemas/
/gen/apple/build/
/gen/apple/Externals/
/gen/apple/assets/
/gen/apple/Pods/
/gen/apple/*.xcodeproj/
/gen/apple/*.xcworkspace/
/gen/apple/xcuserdata/
# The Android project is generated, but its manifest carries a change that has
# to survive regeneration, so its sources are kept and only what a build
# leaves behind is not.
/gen/android/app/build/
/gen/android/build/
/gen/android/.gradle/
/gen/android/local.properties
